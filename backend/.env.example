# Copie para .env e ajuste os valores.

# PostgreSQL (RNF02). Em produção na Vercel, use uma URL com pooling (Neon, Supabase, Vercel Postgres).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/headstock?schema=public"

# Segredo usado para assinar os tokens JWT. Use uma string longa e aleatória.
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"

# URL pública desta API (usada para montar a URL absoluta das fotos enviadas).
PUBLIC_URL="http://localhost:3333"

# Origens autorizadas a chamar a API (frontend), separadas por vírgula.
CORS_ORIGINS="http://localhost:3000"

PORT=3333
