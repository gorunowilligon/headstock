# Copie para .env e ajuste os valores.

# PostgreSQL (RNF02). Em produção na Vercel, use a URL com pooling do Supabase (porta 6543).
# Caracteres especiais na senha devem ser codificados (ex.: ^ = %5E, % = %25).
DATABASE_URL="postgresql://postgres.<project-ref>:<SENHA>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Segredo usado para assinar os tokens JWT. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN="7d"

# URL pública desta API (usada para montar a URL absoluta das fotos enviadas).
PUBLIC_URL="http://localhost:3333"

# Origens autorizadas a chamar a API (frontend), separadas por vírgula.
CORS_ORIGINS="http://localhost:3000"

PORT=3333
